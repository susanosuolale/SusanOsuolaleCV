@{
    ViewData["Title"] = "Upload Image";
}

<div class="card card-feminine upload-card">
    <div class="card-body">
        <h3 class="section-heading">Upload an Image</h3>
        <p class="text-muted">Choose an image and give it a short title.</p>

        <form asp-action="Upload" asp-controller="Gallery" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" class="form-control form-control-lg" id="title" name="title" placeholder="A short descriptive title" />
            </div>
            <div class="mb-3">
                <label for="imageFile" class="form-label">Select Image</label>
                <input type="file" class="form-file-input form-control" id="imageFile" name="imageFile" accept="image/*" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-accent">Upload</button>
                <a class="btn btn-outline-secondary" href="/Gallery">Back to Gallery</a>
            </div>
        </form>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="text-danger mt-3">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }
    </div>
</div>
