<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SusanOsuolaleCV</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="feminine-bg">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">OJONE SUSAN OSUOLALE</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav align-items-lg-center gap-lg-1 ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="About" asp-action="Index">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Experience" asp-action="Index">Experience</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Education" asp-action="Index">Education</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Projects" asp-action="Index">Projects</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">More</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Gallery" asp-action="Index">Gallery</a></li>
                                <li><a class="dropdown-item" asp-controller="Gallery" asp-action="Upload">Upload Image</a></li>
                                <li><a class="dropdown-item" asp-controller="Tax" asp-action="Index">Tax Calculator</a></li>
                                <li><a class="dropdown-item" asp-controller="Contact" asp-action="Index">Contact</a></li>
                            </ul>
                        </li>
                        <li class="nav-item mt-2 mt-lg-0"><a class="nav-link cv-download-link" asp-controller="Cv" asp-action="Download">Download CV</a></li>
                    </ul>
                </div>

    <div id="cv-download-notification" class="alert alert-success position-fixed bottom-0 end-0 m-3 d-none" role="alert"></div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-4">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <strong>OJONE SUSAN OSUOLALE</strong> — Backend Software Engineer
            </div>
            <div>
                <a href="https://github.com/susanosuolale" target="_blank">GitHub</a> •
                <a href="https://linkedin.com/in/ojone-osuolale" target="_blank">LinkedIn</a> •
                <a href="mailto:susanojone@gmail.com">susanojone@gmail.com</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const cvDownloadConnection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/cv-downloads')
            .withAutomaticReconnect()
            .build();

        cvDownloadConnection.on('cvDownloaded', function (downloadedAtUtc) {
            const notification = document.getElementById('cv-download-notification');
            notification.textContent = `CV downloaded at ${new Date(downloadedAtUtc).toLocaleString()}`;
            notification.classList.remove('d-none');
            window.setTimeout(() => notification.classList.add('d-none'), 6000);
        });

        cvDownloadConnection.start().catch(() => { });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
