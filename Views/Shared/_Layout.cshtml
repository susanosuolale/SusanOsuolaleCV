<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SusanOsuolaleCV</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="feminine-bg">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">OJONE SUSAN OSUOLALE</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="About" asp-action="Index">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Experience" asp-action="Index">Experience</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Education" asp-action="Index">Education</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Projects" asp-action="Index">Projects</a></li>
                         <li class="nav-item"><a class="nav-link" data-gallery-link="true" asp-controller="Gallery" asp-action="Index">Gallery</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Gallery" asp-action="Upload">Upload Image</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Tax" asp-action="Index">Tax Calculator</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div id="gallery-loading-notification" class="gallery-loading-notification d-none" role="status" aria-live="polite">
        <div class="gallery-loading-card">
            <div class="gallery-loading-spinner" aria-hidden="true"></div>
            <strong>Our photo album is waking up from a little Azure nap</strong>
            <p class="mb-0">It may take a moment, but your memories are on their way!</p>
        </div>
    </div>

    <div class="container py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <strong>OJONE SUSAN OSUOLALE</strong> — Backend Software Engineer
            </div>
            <div>
                <a href="https://github.com/susanosuolale" target="_blank">GitHub</a> •
                <a href="https://linkedin.com/in/ojone-osuolale" target="_blank">LinkedIn</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('[data-gallery-link="true"]').forEach(function (link) {
            link.addEventListener('click', function (event) {
                if (event.button === 0 && !event.ctrlKey && !event.metaKey && !event.shiftKey && !event.altKey) {
                    document.getElementById('gallery-loading-notification').classList.remove('d-none');
                }
            });
        });

        window.addEventListener('pageshow', function () {
            document.getElementById('gallery-loading-notification').classList.add('d-none');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
