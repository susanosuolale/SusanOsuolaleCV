@model SusanOsuolaleCV.Models.GalleryImage

@{
    ViewData["Title"] = "Image Details";
}

<div class="card card-feminine p-3">
    <div class="card-body text-center">
        <h3 class="section-heading">@Model.Title</h3>
        <p class="text-muted">@Model.Description</p>
        <div class="mb-3">
            <img src="/images/@Model.FileName" alt="@Model.Title" style="max-width:100%; height:auto; border-radius:12px; box-shadow: 0 18px 40px rgba(197,102,153,0.08);" />
        </div>
        <a class="btn btn-secondary" href="/Gallery">Back to Gallery</a>
    </div>
</div>
